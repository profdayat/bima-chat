# App Configuration
COMPOSE_PROJECT_NAME=bima-chat
APP_ENV=development
APP_PORT=8080
FRONTEND_PORT=8095

# Database Configuration (Isolated Container)
DB_HOST=postgres
DB_PORT=5432
DB_USER=bimachat
DB_PASSWORD=changeme_bima_db_password
DB_NAME=bima_chat_db

# Redis Configuration (Isolated Container)
REDIS_URL=redis://redis:6379

# Security (Generate random 32+ characters string)
JWT_SECRET=your-random-jwt-secret-min-32-chars-here

# Host FQDN / Domain
APP_FQDN=localhost:8095
